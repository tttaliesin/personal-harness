{
  "name": "@tttaliesin/personal-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Codex user harness installer",
  "type": "module",
  "bin": {
    "personal-harness": "bin/personal-harness.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "supportedHosts": [
    "homelab-desktop",
    "roylabs-desktop"
  ],
  "files": [
    "registry.toml",
    "requirements.txt",
    "bin",
    "installer",
    "common",
    "skills",
    "dependencies",
    "sources",
    "docs",
    "!docs/history/**",
    "!**/.git/**",
    "!**/.local/**",
    "!**/.audit/**",
    "!**/.venv/**",
    "!**/node_modules/**",
    "!**/__pycache__/**",
    "!**/.pytest_cache/**",
    "!**/.cache/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ]
}
