{
  "name": "@tttaliesin/personal-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Codex user harness installer",
  "type": "module",
  "bin": {
    "personal-harness": "bin/personal-harness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "registry.toml",
    "requirements.txt",
    "bin",
    "scripts",
    "common",
    "hosts",
    "skills",
    "sources",
    "docs",
    "!docs/history/**",
    "!scripts/test.ps1",
    "!**/.git/**",
    "!**/.local/**",
    "!**/.audit/**",
    "!**/.venv/**",
    "!**/node_modules/**",
    "!**/__pycache__/**",
    "!**/.pytest_cache/**",
    "!**/.cache/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ]
}
