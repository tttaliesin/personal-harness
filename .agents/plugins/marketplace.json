{
  "name": "personal-harness",
  "interface": {
    "displayName": "Personal Harness"
  },
  "plugins": [
    {
      "name": "repo-governance",
      "source": {
        "source": "local",
        "path": "./packages/repo-governance/plugin"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "windows-agent-devkit",
      "source": {
        "source": "local",
        "path": "./packages/windows-agent-devkit/release"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "worker-orchestrator",
      "source": {
        "source": "local",
        "path": "./packages/worker-orchestrator/release"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "personal-harness-skills",
      "source": {
        "source": "local",
        "path": "./skills/custom"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "personal-harness-adapters",
      "source": {
        "source": "local",
        "path": "./skills/adapters"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    }
  ]
}
