# Store text sources as UTF-8 with LF line endings.
* text=auto eol=lf

# Keep PowerShell sources ASCII-only for BOM-free Windows PowerShell 5.1 support.
*.ps1 text eol=lf working-tree-encoding=UTF-8

# Published plugin packages retain their verified deployment bytes.
/packages/windows-agent-devkit/release/** -text !eol !working-tree-encoding
/packages/worker-orchestrator/release/** -text !eol !working-tree-encoding

# Preserve the original generated notice, including its ending newline.
/packages/windows-agent-devkit/release/THIRD_PARTY_NOTICES.txt whitespace=-blank-at-eof
