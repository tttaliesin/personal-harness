{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "--harness", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
